<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: allowBackup="false" bulut yedeğini kapatır ama cihazdan cihaza
  aktarımı kapatmaz. Mesajlar, Telegram oturumu ve web servislerinin çerezleri
  hiçbir yedeğe ya da aktarıma girmez.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
